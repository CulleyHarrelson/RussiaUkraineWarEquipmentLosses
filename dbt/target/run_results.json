ssage": "SELECT 7", "failures": null, "unique_id": "model.dbt_equipment_losses.int_equipment_categories", "compiled": true, "compiled_code": "\n\nSELECT\n    predicted_category,\n    COUNT(*) AS total_losses,\n    COUNT(CASE WHEN status = 'destroyed' THEN 1 END) AS destroyed,\n    COUNT(CASE WHEN status = 'captured' THEN 1 END) AS captured,\n    COUNT(CASE WHEN status = 'damaged' THEN 1 END) AS damaged\nFROM \"dbt_equipment_losses\".\"public\".\"stg_equipment_losses\"\nGROUP BY predicted_category", "relation_name": "\"dbt_equipment_losses\".\"public\".\"int_equipment_categories\""}, {"status": "success", "timing": [{"name": "compile", "started_at": "2024-09-21T21:13:32.737373Z", "completed_at": "2024-09-21T21:13:32.740273Z"}, {"name": "execute", "started_at": "2024-09-21T21:13:32.740438Z", "completed_at": "2024-09-21T21:13:32.909007Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.17270183563232422, "adapter_response": {"_message": "SELECT 1710", "code": "SELECT", "rows_affected": 1710}, "message": "SELECT 1710", "failures": null, "unique_id": "model.dbt_equipment_losses.int_cumulative_losses", "compiled": true, "compiled_code": "\n\nSELECT\n    date_recorded,\n    predicted_category,\n    COUNT(*) AS daily_losses,\n    SUM(COUNT(*)) OVER (PARTITION BY predicted_category ORDER BY date_recorded) AS cumulative_losses\nFROM \"dbt_equipment_losses\".\"public\".\"stg_equipment_losses\"\nGROUP BY date_recorded, predicted_category", "relation_name": "\"dbt_equipment_losses\".\"public\".\"int_cumulative_losses\""}, {"status": "success", "timing": [{"name": "compile", "started_at": "2024-09-21T21:13:32.910863Z", "completed_at": "2024-09-21T21:13:32.912504Z"}, {"name": "execute", "started_at": "2024-09-21T21:13:32.912679Z", "completed_at": "2024-09-21T21:13:32.927802Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.017531156539916992, "adapter_response": {"_message": "SELECT 1710", "code": "SELECT", "rows_affected": 1710}, "message": "SELECT 1710", "failur